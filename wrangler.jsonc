{
  // Cloudflare Workers static-assets config — serves the repo root as the site.
  "name": "vidgo",
  // worker/index.ts only 301s www + http to https://vidgotech.com and hands
  // everything else to the assets binding (see the file header).
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-12",
  // Keep the workers.dev test URL alive alongside the custom domains —
  // omitting this makes each deploy silently disable it.
  "workers_dev": true,
  // Custom domains — wrangler creates the DNS records and certificates
  // on deploy; no manual dashboard steps needed.
  "routes": [
    { "pattern": "vidgotech.com", "custom_domain": true },
    { "pattern": "www.vidgotech.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // The redirect must see every request, including ones that match an asset.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
